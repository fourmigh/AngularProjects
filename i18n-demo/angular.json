{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "i18n-demo": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": {
          "code": "en-US",
          "subPath": ""
        },
        "locales": {
          "zh": {
            "translation": [
              "src/locale/messages.zh.xlf"
            ],
            "subPath": "zh"
          },
          "de": {
            "translation": [
              "src/locale/messages.de.xlf"
            ],
            "subPath": "de"
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/i18n-demo",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/app/custom-i18n/assets",
                "output": "/assets"
              },
              {
                "glob": "translations.json",
                "input": "src/app/custom-i18n/i18n",
                "output": "/i18n"
              },
              {
                "glob": "**/*",
                "input": "src/locale",
                "output": "/locale"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": [],
            "loader": {
              ".ttf": "file"
            }
          },
"configurations": {
              "production": {
                "budgets": [
                  {
                    "type": "initial",
                    "maximumWarning": "4MB",
                    "maximumError": "6MB"
                  },
                  {
                    "type": "anyComponentStyle",
                    "maximumWarning": "4kB",
                    "maximumError": "8kB"
                  }
                ],
                "outputHashing": "all"
              },
              "development": {
                "optimization": false,
                "extractLicenses": false,
                "sourceMap": true
              },
              "compile": {
                "optimization": true,
                "extractLicenses": false,
                "sourceMap": false,
                "outputHashing": "all",
                "localize": true,
                "fileReplacements": [
                  {
                    "replace": "src/app/app.routes.ts",
                    "with": "src/app/app.routes.compile.ts"
                  },
                  {
                    "replace": "src/app/features.ts",
                    "with": "src/app/features.compile.ts"
                  }
                ]
              }
            },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "i18n-demo:build:production"
            },
            "development": {
              "buildTarget": "i18n-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "i18n-demo:build:compile",
            "outputPath": "src/locale",
            "format": "xlf2"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}
